    {
      "name": "Register user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"applytrack-{{$guid}}@example.test\",\n  \"password\": \"{{user_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset('registered_email');",
              "pm.environment.unset('access_token');",
              "pm.environment.unset('application_id');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('returns user and access token JSON', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
              "  pm.expect(body.user).to.be.an('object');",
              "  pm.expect(body.user.email).to.be.a('string');",
              "  pm.environment.set('registered_email', body.user.email);",
              "});"
            ]
          }
        }
      ]
    },
    {
