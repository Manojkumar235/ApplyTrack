              "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('returns user and saves JWT access token', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.user.email).to.eql(pm.environment.get('registered_email'));",
              "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
              "  pm.environment.set('access_token', body.access_token);",
              "});"
            ]
          }
        }
